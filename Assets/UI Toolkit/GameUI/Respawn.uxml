<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/GameUI/GameUIStyleSheet.uss?fileID=7433441132597879392&amp;guid=35b9b2a65173fdb47ad41dfdb0b5a02a&amp;type=3#GameUIStyleSheet" />
    <ui:VisualElement name="Canvas" picking-mode="Ignore" class="canvas canvas-transparent-background">
        <ui:VisualElement name="Container" picking-mode="Ignore" class="container container-in-game">
            <ui:VisualElement name="UIWrapper" picking-mode="Ignore">
                <ui:VisualElement name="UILayout" picking-mode="Ignore">
                    <ui:Label text="Respawning in X..." name="RespawnMessage" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="LobbyPanel" class="lobby-panel">
                <ui:Label text="MATCH LOBBY" name="LobbyTitle" class="lobby-title" picking-mode="Ignore"/>
                <ui:Label text="SESSION" name="LobbySession" class="lobby-session" picking-mode="Ignore"/>
                <ui:Label text="PLAYERS 0" name="LobbyPlayerCount" class="lobby-player-count" picking-mode="Ignore"/>
                <ui:Label text="Waiting for players..." name="LobbyPlayerList" class="lobby-player-list" picking-mode="Ignore"/>
                <ui:Label text="WAITING FOR HOST" name="LobbyStatus" class="lobby-status" picking-mode="Ignore"/>
                <ui:Button text="START MATCH" name="LobbyStartButton" class="lobby-start-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
